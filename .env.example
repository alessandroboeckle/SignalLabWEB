# Kopiere diese Datei zu .env und trage die Werte deines eigenen
# Supabase-Projekts ein. Ohne .env greift der bisherige fest eingetragene
# Wert in src/lib/supabase.js als Fallback — nichts bricht.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-publishable-key

# Optional: error tracking (see README "Error-Tracking"). Leave unset to
# run without it — nothing breaks, errors just only land in the browser
# console instead of also being reported.
VITE_SENTRY_DSN=
